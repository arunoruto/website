#!/usr/bin/env bash

export DIRENV_WARN_TIMEOUT=20s

if has nix; then
  if [ -d "$HOME/.config/flake" ]; then
    echo "direnv: found local flake at $HOME/.config/flake, using it"
    use flake "$HOME/.config/flake#website"
  else
    echo "direnv: no local flake at $HOME/.config/flake, falling back to github:arunoruto/flake"
    use flake "github:arunoruto/flake#website"
  fi
else
  echo "direnv: nix not found on PATH, skipping flake shell"
fi

# Local secrets for scripts/sync_publications.py (GOOGLE_SCHOLAR_ID,
# SERPAPI_KEY) - gitignored; CI gets the same names from repository secrets.
dotenv_if_exists .env
