.env

# Generated files by hugo
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# Executable may be added to repository
hugo.exe
hugo.darwin
hugo.linux

# Temporary lock file while building
/.hugo_build.lock

# direnv
.direnv

# Editor/tool backups - git is the backup
*.bak

# Python
__pycache__/
*.pyc

# Claude Code - per-machine overrides and runtime state, not shared config
.claude/settings.local.json
.claude/scheduled_tasks.lock
